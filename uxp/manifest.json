{
  "manifestVersion": 5,
  "id": "com.stereodepth.premiere",
  "name": "StereoDepth — 2D to 3D",
  "version": "0.3.1",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["http://127.0.0.1:48731"] }
  },
  "entrypoints": [{
    "type": "panel", "id": "stereodepth", "label": { "default": "2D to 3D" },
    "minimumSize": { "width": 300, "height": 400 },
    "preferredDockedSize": { "width": 340, "height": 720 },
    "preferredFloatingSize": { "width": 380, "height": 820 }
  }]
}
